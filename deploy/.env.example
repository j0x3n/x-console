# 面板域名，Caddy 会自动申请证书。域名要先解析到这台服务器。
XC_DOMAIN=console.example.com
XC_PUBLIC_URL=https://console.example.com
# 生成：openssl rand -base64 32 。一定要备份，丢了就解不开存进去的令牌。
XC_MASTER_KEY=
XC_TZ=Asia/Shanghai
# 面板在服务器本机监听的端口，反向代理指向 127.0.0.1:这个端口
XC_PORT=17380
# 自动安装或更新面板所在服务器的代理。设为 0 并再次部署可彻底卸载。
XC_LOCAL_AGENT=1
# 服务器上没有反向代理时取消下一行的注释，使用自带的 Caddy
# COMPOSE_PROFILES=caddy
